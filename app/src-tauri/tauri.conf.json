{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BHNotepad",
  "version": "0.1.0",
  "identifier": "com.biswashost.bhnotepad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5274",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BHNotepad",
        "width": 1040,
        "height": 700,
        "minWidth": 520,
        "minHeight": 320,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A notepad whose unsaved tabs survive quitting.",
    "longDescription": "BHNotepad keeps every tab exactly where you left it. Close a tab or quit the app with unsaved scratch notes and it never asks you to save or discard — the text is already on disk, and all of your tabs come back next time. Syntax highlighting, regex find and replace, and no telemetry.",
    "copyright": "Copyright (c) 2026 Benjamin Biswas (BiswasHost)",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "txt", "text", "log", "md", "markdown", "nfo",
          "json", "jsonc", "yaml", "yml", "toml", "ini", "cfg", "conf", "properties", "env",
          "csv", "tsv", "xml", "svg", "plist",
          "html", "htm", "css", "scss", "sass", "less",
          "js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx",
          "py", "rb", "pl", "pm", "php", "lua", "tcl", "r",
          "c", "h", "cpp", "cxx", "cc", "hpp", "hxx", "rs", "go", "swift",
          "java", "kt", "cs", "vb",
          "sh", "bash", "zsh", "fish", "ps1", "bat", "cmd",
          "sql", "diff", "patch", "gradle", "cmake", "dockerfile"
        ],
        "name": "Text Document",
        "description": "Plain text and source files",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
